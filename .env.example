# WhatsApp Cloud API
VERIFY_TOKEN=replace-with-webhook-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
# Digits are normalized; this is a single-owner application.
WHATSAPP_OWNER_PHONE=replace-with-phone-number

# Agent services: OpenRouter is the default when its key is present.
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
# Or use OpenAI directly instead:
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=replace-with-groq-key
USER_TIMEZONE=Europe/Paris

# Notion
NOTION_API_TOKEN=replace-with-notion-integration-token
NOTION_PARENT_PAGE_ID=replace-with-notes-parent-page-id
NOTION_CALENDAR_DATA_SOURCE_ID=replace-with-calendar-data-source-id

# Local tunnel and optional tuning
NGROK_AUTHTOKEN=replace-with-ngrok-token
NGROK_DOMAIN=replace-with-reserved-ngrok-domain
PORT=8085
DEFAULT_EVENT_DURATION_MINUTES=30
LLM_TIMEOUT_MS=30000
GROQ_TIMEOUT_MS=30000
META_TIMEOUT_MS=15000
NOTION_TIMEOUT_MS=15000
